{
	"appId": "online.qwercrool.app",
	"appName": "QWERcrool",
	"webDir": "dist",
	"server": {
		"url": "https://qwercrool.online",
		"cleartext": true,
		"androidScheme": "https"
	},
	"android": {
		"allowMixedContent": true,
		"captureInput": false,
		"backgroundColor": "#0d0f17"
	},
	"ios": {
		"contentInset": "never",
		"backgroundColor": "#0d0f17",
		"allowsLinkPreview": false,
		"scrollEnabled": false
	},
	"plugins": {
		"SplashScreen": {
			"launchShowDuration": 1800,
			"launchAutoHide": true,
			"backgroundColor": "#0d0f17",
			"androidScaleType": "CENTER_CROP",
			"splashFullScreen": true,
			"splashImmersive": true
		},
		"StatusBar": {
			"style": "DARK",
			"backgroundColor": "#0d0f17"
		},
		"LocalNotifications": {
			"smallIcon": "ic_stat_notification",
			"iconColor": "#7c5bf5",
			"sound": "default"
		}
	},
	"packageClassList": [
		"CAPCameraPlugin",
		"LocalNotificationsPlugin"
	]
}
